# 統合スタック（asset-summary + crypto-summary）の環境変数設定例。
# cp .env.example .env して編集する。.env は gitignore 済み。
#
# ローカル開発（docker なし・単体起動）は何も設定しなくてよい。
# docker compose を使う場合は CS_CONTEXT と CS_SERVICE_TOKEN から。

# =====================================================================
# データベース（docker なしの単体起動用。compose では自動設定される）
# =====================================================================
# SQLite ファイルのパス（既定: data/assets.db）
#AS_DB_PATH=data/assets.db

# =====================================================================
# ビルドコンテキスト
# =====================================================================
# Crypto-Summary リポジトリの場所（compose の build に使う）。
# VM で兄弟ディレクトリに clone したなら未設定（../Crypto-Summary）でよい。
# 別の場所にあるなら絶対パスで書く（Windows も / 区切り）:
#CS_CONTEXT=C:/path/to/Crypto-Summary
CS_CONTEXT=

# =====================================================================
# Crypto-Summary のログインモード（ローカル compose のみ切替可能）
#   未設定       → DATA_DIR=/data、マルチユーザー（Google ログイン必須）
#   DATA_DIR=    → 空にするとシングルユーザー（ログイン無し）。手元で試すだけなら
#                  こちらが簡単で、下の CS_SERVICE_TOKEN も CS_USER_SUB も不要。
# クラウド (docker-compose.cloud.yml) は常にマルチユーザー固定。
# =====================================================================
#DATA_DIR=
#DB_PATH=/data/ledger.db

# =====================================================================
# AS ⇔ CS サービス間認証（両サービスに同じ値が渡る）
# CS がマルチユーザー（DATA_DIR あり）のとき、AS からの読み取りに必須。
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
# =====================================================================
CS_SERVICE_TOKEN=

# CS がマルチユーザーのとき、AS がどのユーザーの台帳を読むか（Google sub）。
# AS のログインゲートを有効にしている場合は不要（ログインした人の sub を使う）。
# 自分の sub は CS にログインして /auth/me で確認できる。
CS_USER_SUB=

# =====================================================================
# 公開 URL（クラウドのみ必須。caddy の 2 サブドメインと一致させる）
# Google OAuth のリダイレクト URI には
#   ${AS_PUBLIC_URL}/auth/callback と ${CS_PUBLIC_URL}/auth/callback
# の両方を同じ OAuth クライアントに登録すること。
#
# ローカルの docker compose では未設定でよい（既定で
# http://localhost:8010 / http://localhost:8000 を使う）。ホスト名を
# 127.0.0.1 に変えると、登録済みのリダイレクト URI と一致せず
# CS のログインが通らなくなるので注意。
#
# AS_PUBLIC_URL はカンマ区切りで複数書ける。ポート転送などで入口が
# 2つあるときは両方を並べておくと、開いた入口に応じたリダイレクト URI が
# 使われる（Google 側にも両方の /auth/callback を登録しておくこと）:
#   AS_PUBLIC_URL=http://localhost:8010,http://example.net:1000
#
# サブパスで公開する場合（https://例.com/asset/ のように階層を持たせる）は
# URL にパスまで書く。接頭辞は先頭エントリのパスから決まる（AS_ROOT_PATH で
# 明示することもできる）。リバースプロキシ側は接頭辞を落とさずそのまま
# 転送する設定にすること（nginx なら proxy_pass の末尾にスラッシュを付けない）:
#   AS_PUBLIC_URL=https://例.com/asset
#AS_ROOT_PATH=/asset
# =====================================================================
AS_PUBLIC_URL=
CS_PUBLIC_URL=
# caddy 用ホスト名（URL からスキームを除いたもの）
AS_HOST=
CS_HOST=
# アプリポートの publish 先。既定 (127.0.0.1) は自分の端末からのみアクセス可。
# ローカルで LAN の他端末（スマホ等）から見たい場合や、クラウドで caddy を
# 使わず直接公開する場合のみ 0.0.0.0 にする（ローカルは無認証で全 API が
# 開く点に注意）。
#BIND_ADDR=0.0.0.0

# コンテナの暦（既定 Asia/Tokyo）。スナップショットの as_of と前日比の
# 「前日」がこれで決まる。UTC にすると、日本時間の朝に取り込んだぶんが
# 前日の日付で入り、前日比が UTC 日付をまたいだ時点で 0 に戻る。
#TZ=Asia/Tokyo

# =====================================================================
# Google OAuth（クラウドでは必須・ローカルは空でよい）
# 1 つの OAuth クライアントを AS / CS で共用する。
# docker-compose.cloud.yml はこれらが空だと起動を拒否する —
# 未設定のまま公開すると CS の無認証セットアップ API が晒されるため。
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AS へのログインを許可する Google アカウント（カンマ区切り）。
# これを設定すると AS のログインゲートが有効になる。
AS_ALLOWED_EMAILS=
# CS の管理者（システムキー設定などができる人）
ADMIN_EMAILS=

# =====================================================================
# セッション・暗号鍵（空なら各アプリが /data に自動生成する）
# =====================================================================
# CS のセッション署名鍵
SECRET_KEY=
# AS のセッション署名鍵
AS_SECRET_KEY=
# CS の API キー暗号化マスター鍵（crypto-summary account gen-key で生成）。
# クラウド (docker-compose.cloud.yml) では必須。
CS_SECRET_KEY=

# =====================================================================
# 外部 API（任意）
# =====================================================================
# CoinGecko Demo キー（CS の価格取得が安定する。無くても動く）
COINGECKO_API_KEY=

# =====================================================================
# AS の CORS 許可オリジン（通常は不要。空なら localhost 既定値）
# =====================================================================
AS_ALLOWED_ORIGINS=

# =====================================================================
# マネーフォワードME PDF の受信フォルダ（自動取込）
# 空なら既定（DB と同じディレクトリの inbox/ — compose では /data/inbox、
# つまりホストの ./data/inbox）。別の場所を監視するならパスを書く。
# off にすると機能ごと無効。
# =====================================================================
AS_MF_INBOX_DIR=
# スキャン間隔（秒、既定 30）
AS_MF_INBOX_POLL=

# =====================================================================
# PBR Lending クローラー連携（Crypto-Summary の機能。使う場合のみ）
#
# 当年分の取引履歴は公式 CSV が出ないため、手元のクローラー
# （PBRLending-History-Check）の出力を Crypto-Summary に読ませる。
# クローラー自体の起動はこのスタックの範囲外で、PBR リポジトリ側の
# compose を単独で動かす。
#
# 使う手順:
#   1. PBR_REPO_DIR にクローラーのリポジトリを書く（Windows も / 区切り）
#   2. PBR_CRAWL_DIR=/pbr-outputs にする（コンテナ内のマウント先）
#   3. docker-compose.yml の crypto-summary の volumes にある
#      "${PBR_REPO_DIR}/outputs:/pbr-outputs:ro" のコメントを外す
#   4. Crypto-Summary の画面で利用者ごとの連携トグルを ON にする
# =====================================================================
#PBR_REPO_DIR=C:/path/to/PBRLending-History-Check
PBR_REPO_DIR=
PBR_CRAWL_DIR=

# クローラーのビューア画面 URL。書くと Crypto-Summary のサイドバーにタブが出る。
# 開くのは利用者のブラウザなので、本体が Docker 内でもホストの 127.0.0.1 でよい。
PBR_VIEWER_URL=

# =====================================================================
# Syncthing（クローラーの出力を別マシンから同期する場合のみ）
# 設定すると Crypto-Summary のインポート画面から同期相手を登録できる。
# クラウド構成では --profile syncthing でサイドカーを立てられる。
# =====================================================================
SYNCTHING_URL=
SYNCTHING_API_KEY=
